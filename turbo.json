{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "BUILD_STANDALONE",
    "NODE_ENV",
    "CORE_DATABASE_URL",
    "JWT_SECRET",
    "RSA_PRIVATE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}