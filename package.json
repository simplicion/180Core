{
  "name": "180-core",
  "version": "1.0.0",
  "private": true,
  "description": "180 Sovereign Core Platform: Universal Identity, 180 Pay, Sovereign Wallets & Developer Portal",
  "scripts": {
    "build": "pnpm build:sdk && turbo run build",
    "build:sdk": "pnpm --filter @workspace/identity-sdk build && node scripts/deploy-180-core-sdk.mjs",
    "test:sdk": "pnpm build:sdk && node scripts/test-180-core-sdk-e2e.mjs",
    "dev": "node scripts/dev-runner.js",
    "dev:all": "node scripts/dev-runner.js all",
    "dev:backend": "pnpm --filter 180-core-backend dev",
    "dev:profile": "pnpm --filter 180-profile-frontend dev",
    "dev:developers": "pnpm --filter 180developers-frontend dev",
    "dev:admin": "pnpm --filter 180-admin-frontend dev",
    "db:generate": "pnpm --filter @workspace/db-180core generate",
    "db:push": "pnpm --filter @workspace/db-180core db:push",
    "db:migrate": "pnpm --filter @workspace/db-180core migrate:dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "node scripts/test-all.mjs"
  },
  "devDependencies": {
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "^5.9.3",
    "cross-env": "^7.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": "9"
  }
}