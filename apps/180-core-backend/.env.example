PORT=4003
NODE_ENV=development

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key

# Database Connections (PostgreSQL with Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/180core_db?schema=public"

# Google OAuth (For Sovereign 180 Profile Login)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# LinkedIn OAuth 2.0 (OpenID Connect)
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Sovereign Payment Gateway Configuration (Dual-Gateway Support: RAZORPAY or STRIPE)
# Set PAYMENT_GATEWAY="STRIPE" to switch platform-wide to Stripe, or "RAZORPAY" for Razorpay (default)
PAYMENT_GATEWAY="RAZORPAY"

# Razorpay Credentials (for India / UPI / Managed Settlements)
RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Stripe Credentials (for International Cards / Apple Pay / Platform or BYOG)
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email SMTP (For OTP Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@180core.cloud"
SMTP_PASS="your_app_password"
EMAIL_FROM="notifications@180core.cloud"

# MSG91 WhatsApp / SMS OTP
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
MSG91_WHATSAPP_INTEGRATED_NUMBER="919381420546"
MSG91_WHATSAPP_TEMPLATE_NAME="welcome"
MSG91_WHATSAPP_LANG="en"

# Recurring Billing Cron Secret (For authenticating external scheduler calls to POST /api/v1/subscriptions/run-billing-cycle)
BILLING_CRON_SECRET="your_billing_cron_secret"

# 180 Core Platform OAuth Client Credentials (from your developer account app in 180 Developer Portal)
CORE_CLIENT_ID="180_client_your_client_id_here"
CORE_CLIENT_SECRET="your_core_client_secret_here"
CORE_WEBHOOK_SECRET="your_core_webhook_secret_here"

# 180 Core Redirect URIs & Allowed Origins (comma-separated, completely env-driven)
CORE_REDIRECT_URIS="http://localhost:3008/oauth/callback,http://localhost:3009/oauth/callback"
# Frontend URLs
PROFILE_FRONTEND_URL="http://localhost:3008"
DEVELOPERS_FRONTEND_URL="http://localhost:3009"
CLIENT_URL="http://localhost:3008,http://localhost:3009,http://localhost:3010"

# Government of India API Setu Gateway (Approved Consumer)
APISETU_CLIENT_ID="com.simplicion"
APISETU_API_KEY="your_apisetu_api_key_here"
APISETU_BASE_URL="https://apisetu.gov.in/api/v1"
# NOTE: APISETU_BASE_URL is the API Setu gateway root (https://apisetu.gov.in). Each publisher has its
# own versioned path (/pan/v3/pancr/certificate, /transport/v3/drvlc/certificate ...); a trailing
# "/api/v1" in the value above is ignored by the client.

# ─── 180 Verify (KYC) ───────────────────────────────────────────────────────
# Provider mode: "mock" = deterministic sandbox fixtures (see src/services/verification/README.md),
# "live" = real API Setu + Razorpay. Default: mock when NODE_ENV != production, live in production.
VERIFY_PROVIDER_MODE="mock"
# Optional per-provider overrides (e.g. go live on Razorpay before API Setu): mock | live
# VERIFY_APISETU_MODE="mock"
# VERIFY_RAZORPAY_MODE="mock"
# In production the verification module refuses to serve in mock mode unless this is "true".
# Results are always stamped environment:"sandbox" when any provider is mocked.
VERIFY_ALLOW_SANDBOX_IN_PRODUCTION="false"
# HS256 secret for short-lived session tokens (REQUIRED in production; generate: openssl rand -hex 32).
# Final results are signed RS256 with the platform JWKS key (OAUTH_RSA_PRIVATE_KEY / packages/keys).
VERIFY_SESSION_SECRET="change_me_to_a_long_random_secret"
# Sandbox only: artificial mock latency override in ms (default random 100-400ms)
# VERIFY_MOCK_LATENCY_MS=""
# Max time to poll a Razorpay penny drop before returning PENDING (ms)
# VERIFY_PENNY_DROP_MAX_WAIT_MS="30000"
# B2B endpoint rate limit per client per minute
# VERIFY_B2B_RATE_LIMIT_PER_MIN="30"

# RazorpayX source (debit) account number used for Fund Account Validation (penny drop).
# Differs between Test and Live mode. Uses RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET above.
RAZORPAYX_ACCOUNT_NUMBER=""

# Biometrics engine (apps/180-biometrics-service)
BIOMETRICS_SERVICE_URL="http://127.0.0.1:8090"
# Must equal the key configured on the biometrics service
BIOMETRICS_SERVICE_KEY=""
BIOMETRICS_TIMEOUT_MS=15000
# If true and the engine did not apply passive anti-spoofing, the best possible verdict is MANUAL_REVIEW.
# Default false in development; true recommended (and the default) in production.
REQUIRE_PASSIVE_ANTISPOOF="false"
